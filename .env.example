# Renombra este archivo a ".env" y coloca tu token real
BOT_TOKEN=TU_TOKEN_DE_BOTFATHER_AQUI

# ID de tu usuario de Telegram (para comandos de owner). Puedes obtenerlo con @userinfobot
OWNER_ID=123456789

# Nombre del bot que se muestra en los mensajes
BOT_NAME=FamilyBot-MD

# --- Configuración de IA (Anthropic / Claude) ---
# Consigue tu API key en https://console.anthropic.com/
ANTHROPIC_API_KEY=TU_API_KEY_DE_ANTHROPIC_AQUI

# Modelo a usar (claude-haiku-4-5-20251001 es rápido y económico, ideal para un bot)
AI_MODEL=claude-haiku-4-5-20251001